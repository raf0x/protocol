{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mypepprotocol.local/schemas/agent-orchestrator/task-plan.schema.json",
  "title": "Task plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactType", "taskId", "runId", "revision", "packetHash", "baseCommit", "candidateId", "producer", "result", "blockers", "evidenceRefs", "risk", "requiredRoles", "allowedPaths", "productQa"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactType": { "const": "task_plan" },
    "taskId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "packetHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseCommit": { "type": "string", "minLength": 1 },
    "candidateId": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
    "producer": { "type": "object", "additionalProperties": false, "required": ["role", "identity"], "properties": { "role": { "type": "string", "minLength": 1 }, "identity": { "type": "string", "minLength": 1 } } },
    "result": { "enum": ["pass", "fail", "blocked", "not_run", "not_required"] },
    "blockers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "enum": ["SCOPE_EXPANSION", "UNAUTHORIZED_PATH", "RISK_MISMATCH", "PRODUCT_DECISION_REQUIRED", "MISSING_EVIDENCE", "REVIEW_LIMIT", "VALIDATION_FAILED", "RELEASE_AUTHORIZATION_ABSENT", "DESTRUCTIVE_OR_PRODUCTION_MUTATION", "BUDGET_EXHAUSTED", "RUNTIME_FAILURE", "INTEGRITY_FAILURE", "WORKSPACE_DRIFT"] }, "message": { "type": "string", "minLength": 1 } } } },
    "evidenceRefs": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "type", "candidateId", "result"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "candidateId": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "result": { "enum": ["pass", "fail", "blocked", "not_run", "not_required"] } } } },
    "risk": { "enum": ["low", "medium", "high"] },
    "requiredRoles": { "type": "array", "uniqueItems": true, "items": { "enum": ["architect", "implementer", "reviewer"] } },
    "allowedPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "productQa": { "type": "object", "additionalProperties": false, "required": ["result", "reason", "candidateId", "producerType", "evidenceRef"], "properties": { "result": { "enum": ["pass", "fail", "blocked", "not_run", "not_required"] }, "reason": { "type": "string", "minLength": 1 }, "candidateId": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] }, "producerType": { "enum": ["human", "coordinator"] }, "evidenceRef": { "type": "string", "minLength": 1 } } }
  }
}
